# RNS Global environment variables
# Copy this file to `.env` and fill in what you need. Nothing secret is ever shipped to the client.

# ---- Contact / lead routing (optional) ----
VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---- AI image generation (build-time only, never exposed to the browser) ----
# provider: openai | replicate | stability
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
IMAGE_MODEL=gpt-image-1

# ---- Analytics (loaded only after cookie consent) ----
VITE_GA_ID=
VITE_META_PIXEL_ID=
